# Build / IDE
.vs/
.vscode/
**/obj/
**/bin/
!bin/.gitkeep
src/native/build/
build/
infrastructure/site/
site/

# Native / managed outputs (rebuild via rimkit build)
mod/Assemblies/*.dll
mod/Assemblies/*.pdb
mod/Assemblies/*.xml
!mod/Assemblies/.gitkeep
mod/Native/*.dll
mod/Native/*.pdb
!mod/Native/.gitkeep
bin/*.exe
bin/*.pdb

# Scrape / scratch / local agent junk
.firecrawl/
.agents/
skills-lock.json
*.user
*.suo
*.swp
*~
.DS_Store
Thumbs.db

# Extension pack artifacts (keep sources)
src/editor/node_modules/
src/editor/*.vsix
infrastructure/docs-site/node_modules/

# Generated About can stay tracked; ignore accidental dumps
*.log
Player.log
rimkit_ingame_report.json

# Helm build output
helm/build/
*helm
.firecrawl
*profiles
