{
  "name": "rimkit",
  "displayName": "RimKit (RimWorld Lua)",
  "description": "Completions and auto-ship for Stratware RimLuaKit mods.",
  "version": "0.1.0",
  "publisher": "stratware",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": [
    "onLanguage:lua",
    "workspaceContains:meta.lua"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rimkit.ship",
        "title": "RimKit: Ship Mod"
      },
      {
        "command": "rimkit.sync",
        "title": "RimKit: Sync meta.lua"
      }
    ],
    "configuration": {
      "title": "RimKit",
      "properties": {
        "rimkit.autoShipOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Auto-run rimkit mod ship when saving Lua/meta.lua in a RimKit mod."
        },
        "rimkit.executable": {
          "type": "string",
          "default": "rimkit",
          "description": "Path to rimkit.exe (or rimkit on PATH)."
        },
        "rimkit.modsDir": {
          "type": "string",
          "default": "",
          "description": "Optional Mods folder. Empty = rimkit default / RIMWORLD_MODS."
        }
      }
    },
    "languages": [
      {
        "id": "lua",
        "extensions": [".lua"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
