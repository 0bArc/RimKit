declare extern type SignalConnection with
  connected: boolean
  function disconnect(self): ()
  function is_connected(self): boolean
end
declare extern type Signal with
  function connect(self, fn: (...any) -> ()): SignalConnection
  function once(self, fn: (...any) -> ()): SignalConnection
  function fire(self, ...: any): ()
  function wait(self): ...any
  function connection_count(self): number
  function disconnect_all(self): ()
  function destroy(self): ()
end
declare extern type Promise with
  status: string
  function and_then(self, on_resolved: ((any) -> any)?, on_rejected: ((any) -> any)?): Promise
  function catch(self, on_rejected: (any) -> any): Promise
  function finally(self, fn: () -> ()): Promise
  function await(self): (boolean, any)
  function cancel(self): ()
  function get_status(self): string
end
type SignalModule = { new: () -> Signal, is: (value: any) -> boolean }
type PromiseModule = {
  new: (executor: ((any) -> (), (any) -> (), ((() -> ()) -> ())) -> ()) -> Promise,
  resolve: (value: any) -> Promise,
  reject: (err: any) -> Promise,
  try: (fn: (...any) -> any, ...any) -> Promise,
  async: (fn: (...any) -> any, ...any) -> Promise,
  delay: (ticks: number) -> Promise,
  all: (list: {any}) -> Promise,
  race: (list: {any}) -> Promise,
  is: (value: any) -> boolean,
}
